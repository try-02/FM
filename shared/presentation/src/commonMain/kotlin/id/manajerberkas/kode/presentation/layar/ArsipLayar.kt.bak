package id.manajerberkas.kode.presentation.layar

import androidx.compose.foundation.ExperimentalFoundationApi
import androidx.compose.foundation.combinedClickable
import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.material3.Button
import androidx.compose.material3.Checkbox
import androidx.compose.material3.CircularProgressIndicator
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import id.manajerberkas.kode.domain.model.JenisItemArsip
import id.manajerberkas.kode.presentation.state.ArsipState

@OptIn(ExperimentalFoundationApi::class)
@Composable
fun ArsipLayar(
    state: ArsipState,
    onKlikItem: (id.manajerberkas.kode.domain.model.ItemArsip) -> Unit,
    onTekanLama: (id.manajerberkas.kode.domain.model.ItemArsip) -> Unit,
    onKembali: () -> Unit,
    onEkstrakTerpilih: () -> Unit,
    onEkstrakSemua: () -> Unit,
    onBatalkanPilih: () -> Unit,
    onTutup: () -> Unit
) {
    Column(modifier = Modifier.fillMaxSize()) {
        Row(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
            Button(onClick = onKembali, enabled = state.bisaKembali) {
                Text("Kembali")
            }
            Button(onClick = onTutup, modifier = Modifier.padding(start = 8.dp)) {
                Text("Tutup")
            }
        }

        Text(
            text = state.lokasiArsip?.namaTampilan ?: "Arsip",
            style = MaterialTheme.typography.titleMedium,
            modifier = Modifier.padding(horizontal = 8.dp)
        )

        Text(
            text = if (state.jalurAktif.isEmpty()) "/" else "/${state.jalurAktif}",
            style = MaterialTheme.typography.bodySmall,
            modifier = Modifier.padding(horizontal = 8.dp)
        )

        if (state.modePilih) {
            Row(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
                Text("${state.itemTerpilih.size} dipilih", modifier = Modifier.padding(end = 8.dp))
                Button(onClick = onBatalkanPilih) { Text("Batal") }
                Button(
                    onClick = onEkstrakTerpilih,
                    enabled = state.itemTerpilih.isNotEmpty() && !state.sedangEkstrak,
                    modifier = Modifier.padding(start = 8.dp)
                ) { Text("Ekstrak Terpilih") }
            }
        } else {
            Row(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
                Button(
                    onClick = onEkstrakSemua,
                    enabled = !state.sedangEkstrak && state.kemampuan?.bisaEkstrak == true
                ) { Text("Ekstrak Semua") }
            }
        }

        if (state.sedangEkstrak) {
            CircularProgressIndicator(modifier = Modifier.padding(8.dp))
        }

        state.pesan?.let {
            Text(text = it, modifier = Modifier.padding(8.dp))
        }

        if (state.memuat) {
            CircularProgressIndicator(modifier = Modifier.padding(16.dp))
        } else {
            LazyColumn(modifier = Modifier.fillMaxSize()) {
                items(state.daftarTampil) { item ->
                    val terpilih = state.itemTerpilih.contains(item.jalur)

                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .combinedClickable(
                                onClick = { onKlikItem(item) },
                                onLongClick = { onTekanLama(item) }
                            )
                            .padding(12.dp)
                    ) {
                        if (state.modePilih) {
                            Checkbox(
                                checked = terpilih,
                                onCheckedChange = { onKlikItem(item) }
                            )
                        }

                        Text(
                            text = if (item.jenis == JenisItemArsip.FOLDER) "📁" else "📄",
                            modifier = Modifier.padding(end = 8.dp)
                        )

                        Column {
                            Text(item.nama)
                            Text(
                                text = item.jalur,
                                style = MaterialTheme.typography.bodySmall
                            )
                            if (item.jenis == JenisItemArsip.BERKAS) {
                                Text(
                                    text = formatUkuranArsip(item.ukuran),
                                    style = MaterialTheme.typography.bodySmall
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

private fun formatUkuranArsip(byte: Long): String {
    if (byte < 1024) return "$byte B"
    val kb = byte / 1024
    if (kb < 1024) return "$kb KiB"
    val mb = kb / 1024
    if (mb < 1024) return "$mb MiB"
    val gb = mb / 1024
    return "$gb GiB"
}