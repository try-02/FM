package id.manajerberkas.kode.presentation.layar

import androidx.compose.foundation.background
import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.itemsIndexed
import androidx.compose.foundation.lazy.rememberLazyListState
import androidx.compose.material3.Button
import androidx.compose.material3.CircularProgressIndicator
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.runtime.DisposableEffect
import androidx.compose.runtime.LaunchedEffect
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.style.TextOverflow
import androidx.compose.ui.unit.dp
import id.manajerberkas.kode.domain.model.BarisDiff
import id.manajerberkas.kode.domain.model.BarisDiffBerdampingan
import id.manajerberkas.kode.domain.model.JenisOperasiDiff
import id.manajerberkas.kode.domain.model.ModeDiff
import id.manajerberkas.kode.presentation.state.DiffAksi
import id.manajerberkas.kode.presentation.state.DiffState

@Composable
fun DiffLayar(
    state: DiffState,
    aksi: DiffAksi,
    onTutup: () -> Unit
) {
    val listState = rememberLazyListState()

    LaunchedEffect(state.indeksBarisAktif) {
        state.indeksBarisAktif?.let { listState.animateScrollToItem(it) }
    }

    DisposableEffect(Unit) { onDispose { aksi.batal() } }

    Column(modifier = Modifier.fillMaxSize()) {
        Row(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
            Button(onClick = onTutup) { Text("Tutup") }
            Button(
                onClick = { aksi.ubahMode(ModeDiff.UNIFIED) },
                enabled = state.mode != ModeDiff.UNIFIED,
                modifier = Modifier.padding(start = 8.dp)
            ) { Text("Unified") }
            Button(
                onClick = { aksi.ubahMode(ModeDiff.BERDAMPINGAN) },
                enabled = state.mode != ModeDiff.BERDAMPINGAN,
                modifier = Modifier.padding(start = 8.dp)
            ) { Text("Berdampingan") }
            Button(
                onClick = aksi::perubahanSebelumnya,
                enabled = state.blokPerubahan.isNotEmpty(),
                modifier = Modifier.padding(start = 8.dp)
            ) { Text("Sebelumnya") }
            Button(
                onClick = aksi::perubahanBerikutnya,
                enabled = state.blokPerubahan.isNotEmpty(),
                modifier = Modifier.padding(start = 8.dp)
            ) { Text("Berikutnya") }
        }

        Text("A: ${state.lokasiA?.namaTampilan ?: "-"}", style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(horizontal = 8.dp))
        Text("B: ${state.lokasiB?.namaTampilan ?: "-"}", style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(horizontal = 8.dp))

        state.pesan?.let {
            Text(
                text = it,
                modifier = Modifier.padding(8.dp),
                color = if (state.hasil?.identik == true) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.error
            )
        }

        if (state.memuat) {
            CircularProgressIndicator(modifier = Modifier.padding(16.dp))
        }

        state.hasil?.let {
            LazyColumn(state = listState, modifier = Modifier.fillMaxSize()) {
                if (state.mode == ModeDiff.UNIFIED) {
                    itemsIndexed(state.hasil.baris) { index, baris ->
                        val isActiveBlock = state.blokPerubahan.getOrNull(state.indeksBlokAktif)?.let {
                            index in it.indeksAwal..it.indeksAkhir
                        } ?: false
                        BarisDiffUnifiedItem(baris = baris, isActive = isActiveBlock)
                    }
                } else {
                    itemsIndexed(state.barisBerdampingan) { index, baris ->
                        val isActiveBlock = state.blokPerubahan.getOrNull(state.indeksBlokAktif)?.let {
                            index in it.indeksAwal..it.indeksAkhir
                        } ?: false
                        BarisDiffBerdampinganItem(baris = baris, isActiveBlock = isActiveBlock)
                    }
                }
            }
        }
    }
}

@Composable
private fun BarisDiffUnifiedItem(baris: BarisDiff, isActive: Boolean) {
    val backgroundColor = when {
        isActive -> Color.Yellow.copy(alpha = 0.3f)
        baris.jenis == JenisOperasiDiff.HAPUS -> Color.Red.copy(alpha = 0.15f)
        baris.jenis == JenisOperasiDiff.TAMBAH -> Color(0xFF00AA00).copy(alpha = 0.15f)
        else -> Color.Transparent
    }
    val prefix = when (baris.jenis) {
        JenisOperasiDiff.HAPUS -> "-"
        JenisOperasiDiff.TAMBAH -> "+"
        else -> " "
    }
    val prefixColor = when (baris.jenis) {
        JenisOperasiDiff.HAPUS -> Color.Red
        JenisOperasiDiff.TAMBAH -> Color(0xFF00AA00)
        else -> Color.Gray
    }

    Row(modifier = Modifier.fillMaxWidth().background(backgroundColor).padding(horizontal = 8.dp, vertical = 2.dp)) {
        Text(baris.nomorBarisA?.toString()?.padStart(4, ' ') ?: "    ", style = TextStyle(fontFamily = FontFamily.Monospace), color = Color.Gray, modifier = Modifier.padding(end = 4.dp))
        Text(baris.nomorBarisB?.toString()?.padStart(4, ' ') ?: "    ", style = TextStyle(fontFamily = FontFamily.Monospace), color = Color.Gray, modifier = Modifier.padding(end = 8.dp))
        Text(prefix, style = TextStyle(fontFamily = FontFamily.Monospace), color = prefixColor)
        Text(baris.isi, style = TextStyle(fontFamily = FontFamily.Monospace), modifier = Modifier.padding(start = 4.dp), maxLines = 1, overflow = TextOverflow.Ellipsis)
    }
}

@Composable
private fun BarisDiffBerdampinganItem(baris: BarisDiffBerdampingan, isActiveBlock: Boolean) {
    val bgA = when {
        isActiveBlock && baris.jenisA == JenisOperasiDiff.HAPUS -> Color.Red.copy(alpha = 0.15f)
        isActiveBlock && baris.jenisA == null -> Color.Gray.copy(alpha = 0.1f)
        else -> Color.Transparent
    }
    val bgB = when {
        isActiveBlock && baris.jenisB == JenisOperasiDiff.TAMBAH -> Color(0xFF00AA00).copy(alpha = 0.15f)
        isActiveBlock && baris.jenisB == null -> Color.Gray.copy(alpha = 0.1f)
        else -> Color.Transparent
    }

    Row(modifier = Modifier.fillMaxWidth()) {
        Row(modifier = Modifier.weight(1f).background(bgA).padding(horizontal = 4.dp, vertical = 2.dp)) {
            Text(
                baris.nomorA?.toString()?.padStart(4, ' ') ?: "    ",
                style = TextStyle(fontFamily = FontFamily.Monospace),
                color = Color.Gray
            )
            Text(
                baris.teksA ?: "",
                style = TextStyle(fontFamily = FontFamily.Monospace),
                modifier = Modifier.padding(start = 4.dp),
                maxLines = 1,
                overflow = TextOverflow.Ellipsis
            )
        }
        Row(modifier = Modifier.weight(1f).background(bgB).padding(horizontal = 4.dp, vertical = 2.dp)) {
            Text(
                baris.nomorB?.toString()?.padStart(4, ' ') ?: "    ",
                style = TextStyle(fontFamily = FontFamily.Monospace),
                color = Color.Gray
            )
            Text(
                baris.teksB ?: "",
                style = TextStyle(fontFamily = FontFamily.Monospace),
                modifier = Modifier.padding(start = 4.dp),
                maxLines = 1,
                overflow = TextOverflow.Ellipsis
            )
        }
    }
}