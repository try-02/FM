package id.manajerberkas.kode.presentation.layar

import androidx.compose.foundation.layout.Column
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.foundation.lazy.LazyColumn
import androidx.compose.foundation.lazy.items
import androidx.compose.foundation.text.KeyboardOptions
import androidx.compose.material3.AlertDialog
import androidx.compose.material3.Button
import androidx.compose.material3.CircularProgressIndicator
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Text
import androidx.compose.material3.TextField
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.input.KeyboardType
import androidx.compose.ui.unit.dp
import id.manajerberkas.kode.domain.model.HasilPratinjauGantiNama
import id.manajerberkas.kode.presentation.state.GantiNamaMassalState

@Composable
fun GantiNamaMassalLayar(
    state: GantiNamaMassalState,
    onUbahPola: (String) -> Unit,
    onUbahNomorAwal: (String) -> Unit,
    onEksekusi: () -> Unit,
    onTutup: () -> Unit,
    onTutupSetelahEksekusi: () -> Unit
) {
    Column(modifier = Modifier.fillMaxSize()) {
        Row(modifier = Modifier.fillMaxWidth().padding(8.dp)) {
            Button(onClick = onTutup) { Text("Batal") }
            Button(
                onClick = onEksekusi,
                enabled = !state.sedangMemproses && state.jumlahValid > 0,
                modifier = Modifier.padding(start = 8.dp)
            ) { Text("Ganti Nama (${state.jumlahValid}/${state.jumlahItem})") }
        }

        TextField(
            value = state.pola,
            onValueChange = onUbahPola,
            modifier = Modifier.fillMaxWidth().padding(horizontal = 8.dp),
            placeholder = { Text("Pola, contoh: {P}_{N}{S}") },
            label = { Text("Pola Nama") }
        )

        TextField(
            value = state.nomorAwal,
            onValueChange = onUbahNomorAwal,
            modifier = Modifier.fillMaxWidth().padding(horizontal = 8.dp, vertical = 4.dp),
            placeholder = { Text("1") },
            label = { Text("Nomor Awal") },
            keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Number)
        )

        if (state.sedangMemproses) {
            CircularProgressIndicator(modifier = Modifier.padding(8.dp))
        }

        state.pesan?.let {
            Text(
                text = it,
                modifier = Modifier.padding(8.dp),
                color = MaterialTheme.colorScheme.error
            )
        }

        LazyColumn(modifier = Modifier.fillMaxSize()) {
            items(state.pratinjau) { item ->
                ItemPratinjau(item)
            }
        }
    }

    state.hasilEksekusi?.let { hasil ->
        AlertDialog(
            onDismissRequest = onTutupSetelahEksekusi,
            title = { Text("Hasil Operasi") },
            text = {
                Column {
                    Text("Berhasil: ${hasil.count { it.sukses }}")
                    Text("Gagal: ${hasil.count { !it.sukses }}")
                    hasil.filter { !it.sukses }.take(5).forEach {
                        Text("- ${it.pesan ?: "Gagal"}", style = MaterialTheme.typography.bodySmall)
                    }
                }
            },
            confirmButton = {
                Button(onClick = onTutupSetelahEksekusi) { Text("Tutup") }
            }
        )
    }
}

@Composable
private fun ItemPratinjau(item: HasilPratinjauGantiNama) {
    val warna = when {
        item.pesanError != null || item.konflik -> Color.Red
        item.namaBaru != null -> Color(0xFF00AA00)
        else -> Color.Gray
    }

    Column(modifier = Modifier.fillMaxWidth().padding(horizontal = 8.dp, vertical = 4.dp)) {
        Text(text = item.namaLama, style = MaterialTheme.typography.bodyMedium)
        Text(
            text = "→ ${item.namaBaru ?: "(error)"}",
            style = MaterialTheme.typography.bodyMedium,
            color = warna
        )
        item.pesanError?.let {
            Text(
                text = it,
                style = MaterialTheme.typography.bodySmall,
                color = Color.Red
            )
        }
    }
}